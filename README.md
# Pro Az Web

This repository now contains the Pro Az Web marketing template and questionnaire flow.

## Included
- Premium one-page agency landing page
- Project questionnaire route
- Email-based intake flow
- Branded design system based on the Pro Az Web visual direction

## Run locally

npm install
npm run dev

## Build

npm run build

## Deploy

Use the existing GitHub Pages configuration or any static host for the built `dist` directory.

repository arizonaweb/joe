@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg: #f6f1ea;
  --panel: #fbf7f3;
  --panel-strong: #f0e7df;
  --ink: #1f1a17;
  --muted: #5f554f;
  --line: rgba(31, 26, 23, 0.15);
  --accent: #7f6a52;
  --accent-soft: #cbb79d;
  --button-text: #fffdf9;
  --shadow: 0 18px 42px rgba(27, 22, 18, 0.08);
}

html {
  scroll-behavior: smooth;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, textarea, select {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.page-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, rgba(255,255,255,0.2), rgba(0,0,0,0.02));
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.section-pad {
  padding: 88px 0;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(10px);
  background: rgba(246, 241, 234, 0.8);
  border-bottom: 1px solid var(--line);
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82px;
  gap: 24px;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 0.82rem;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--ink);
  color: var(--button-text);
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.35rem;
}

.main-nav {
  display: flex;
  gap: 26px;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 22px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition: 180ms ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button-dark {
  background: var(--ink);
  color: var(--button-text);
}

.button-light {
  background: transparent;
  color: var(--ink);
}

.hero {
  padding-top: 64px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 46px;
  align-items: center;
}

.eyebrow {
  margin: 0 0 18px;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.7rem;
  font-weight: 600;
}

h1, h2, h3 {
  margin: 0;
  line-height: 1.05;
  font-family: 'Cormorant Garamond', serif;
  letter-spacing: -0.04em;
}

h1 {
  max-width: 640px;
  font-size: clamp(4rem, 6vw, 7rem);
  font-weight: 500;
}

h2 {
  font-size: clamp(2.4rem, 4vw, 4rem);
  font-weight: 500;
}

h3 {
  font-size: clamp(1.8rem, 2vw, 2.5rem);
  font-weight: 500;
}

.lede {
  max-width: 600px;
  margin-top: 22px;
  font-size: 1.08rem;
  color: var(--muted);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 32px;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 22px;
  color: var(--muted);
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-panel {
  display: grid;
  gap: 16px;
}

.mini-card {
  background: rgba(255,255,255,0.35);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 26px 24px;
  box-shadow: var(--shadow);
}

.mini-card.highlight {
  background: var(--ink);
  color: var(--button-text);
}

.mini-card label {
  display: block;
  margin-bottom: 8px;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  opacity: 0.8;
}

.mini-card strong {
  font-size: 1.7rem;
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
}

.stats-bar {
  background: var(--panel-strong);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  padding: 22px 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-item strong {
  font-size: 2.1rem;
  font-family: 'Cormorant Garamond', serif;
}

.stat-item span {
  color: var(--muted);
}

.two-col {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 24px;
  align-items: end;
}

.two-col p {
  margin: 0;
  font-size: 1.08rem;
  color: var(--muted);
}

.muted-panel {
  background: rgba(255,255,255,0.22);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.section-header {
  margin-bottom: 28px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.info-card {
  background: rgba(255,255,255,0.4);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 24px;
  box-shadow: var(--shadow);
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 7px 10px;
  background: rgba(127, 106, 82, 0.12);
  color: var(--accent);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.info-card h3 {
  margin-top: 20px;
  margin-bottom: 12px;
  font-size: 2.2rem;
}

.info-card p {
  margin: 0 0 18px;
  color: var(--muted);
}

.info-card strong {
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.process-step {
  background: rgba(255,255,255,0.35);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 24px 22px;
}

.process-step span {
  display: block;
  margin-bottom: 18px;
  color: var(--accent);
  font-size: 0.8rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.process-step p {
  margin: 12px 0 0;
  color: var(--muted);
}

.cta-panel {
  padding-top: 30px;
}

.cta-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 32px 28px;
  border: 1px solid var(--line);
  border-radius: 26px;
  background: var(--panel);
  box-shadow: var(--shadow);
}

.cta-box h2 {
  max-width: 620px;
}

.cta-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.site-footer {
  border-top: 1px solid var(--line);
  background: rgba(255,255,255,0.18);
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 92px;
}

.footer-row p {
  margin: 8px 0 0;
  color: var(--muted);
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
}

.question-shell {
  background: linear-gradient(180deg, rgba(255,255,255,0.22), rgba(255,255,255,0.04));
}

.questionnaire-wrap {
  padding: 64px 0 88px;
}

.question-card {
  max-width: 860px;
  margin: 0 auto;
  background: rgba(255,255,255,0.46);
  border: 1px solid var(--line);
  border-radius: 30px;
  padding: 32px 28px;
  box-shadow: var(--shadow);
}

.question-card h1 {
  margin-top: 8px;
  font-size: clamp(2.8rem, 5vw, 4.2rem);
}

.progress-track {
  margin-top: 26px;
  width: 100%;
  height: 10px;
  background: rgba(31, 26, 23, 0.08);
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-soft));
  border-radius: inherit;
}

.step-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 18px;
  margin-bottom: 28px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.72rem;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 22px;
}

.form-grid > *:last-child,
.form-grid > *:nth-child(2n + 1):last-child {
  grid-column: 1 / -1;
}

label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: var(--ink);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

input, textarea, select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(255,255,255,0.5);
  color: var(--ink);
  padding: 14px 16px;
  letter-spacing: normal;
  text-transform: none;
}

textarea {
  min-height: 130px;
  resize: vertical;
}

.checkbox-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,0.42);
  padding: 12px 14px;
  text-transform: none;
  letter-spacing: 0;
  font-size: 0.95rem;
  color: var(--ink);
}

.check-item input {
  width: auto;
  margin: 0;
}

.question-actions {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 26px;
}

button:disabled {
  opacity: 0.42;
  cursor: not-allowed;
  transform: none;
}

@media (max-width: 960px) {
  .hero-grid,
  .two-col,
  .card-grid,
  .process-grid,
  .stats-grid,
  .cta-box,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }

  .cta-box {
    display: grid;
    align-items: flex-start;
  }
}

@media (max-width: 640px) {
  .nav-wrap {
    padding: 12px 0;
  }

  .button {
    width: 100%;
  }

  .cta-row, .cta-actions, .question-actions {
    flex-direction: column;
  }

  .checkbox-grid {
    grid-template-columns: 1fr;
  }
}
