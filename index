            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }

        /* Base Reveal Class */
        .reveal {
            opacity: 0;
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translate(0, 0) scale(1);
        }

        /* Specific Animation Directions */
        .fade-bottom { transform: translateY(60px); }
        .fade-left { transform: translateX(-60px); }
        .fade-right { transform: translateX(60px); }
        .fade-scale { transform: scale(0.95); }

        /* Staggered Delays for Gallery */
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }
        
        /* Load Animation for Hero */
        .hero-load {
            animation: heroFadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
            transform: translateY(40px);
        }

        @keyframes heroFadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
